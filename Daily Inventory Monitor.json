    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "calculated_status",
              "type": "string",
              "value": "={{ Number($json.quantity) <= 0 ? 'Out of Stock' : (Number($json.quantity) <= Number($json.reorder_point) ? 'Low Stock' : 'In Stock') }}"
            },
            {
              "id": "a2",
              "name": "needs_alert",
              "type": "boolean",
              "value": "={{ Number($json.quantity) <= Number($json.reorder_point) && String($json.alert_sent).toUpperCase() !== 'TRUE' }}"
            },
            {
              "id": "a3",
              "name": "needs_reset",
              "type": "boolean",
              "value": "={{ Number($json.quantity) > Number($json.reorder_point) && String($json.alert_sent).toUpperCase() === 'TRUE' }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
